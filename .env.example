# ---------------------------------------------------------------------------
# FAP Rewards — environment template
#
# Copy this file to `.env` and fill in the REAL values. `.env` is git-ignored
# so your live secrets never end up in the repository.
#
#   cp .env.example .env
#
# On Lovable / serverless hosting these same names are set as project secrets.
# ---------------------------------------------------------------------------

# --- Telegram bot ---
BOT_TOKEN=your-telegram-bot-token
BOT_USERNAME=FAPRewards_OfficialBot
MINI_APP_SHORT_NAME=app

# --- Hosting / URLs ---
PORT=4400
WEBAPP_URL=https://your-domain.com/fap/
API_URL=https://your-domain.com/fap/
FAP_BACKEND_URL=https://api.your-domain.com

# --- Database (Postgres / Neon) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Object storage (S3 compatible) ---
AWS_ENDPOINT_URL_S3=https://your-bucket-endpoint
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-2

# --- Admin access ---
ADMIN_ID=000000000
ADMIN_KEY=change-me

# --- Reward economy ---
MIN_AMOUNT=9
MAX_AMOUNT=98.7
WITHDRAW_FEE=20
MIN_WITHDRAW=50

# --- Ads ---
ADSGRAM_BLOCK_ID=
MONETAG_ZONE=11686396

# --- Required Telegram channels (comma separated) ---
CHANNELS=@NitroxBots,@ARSGiftCode,@PowerxHub,@FAPgvPAYOUTS,@Crpto_Hnter
